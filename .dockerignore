# Git
.git
.gitignore
.gitattributes

# Environment files (NEVER include in image) — any depth
**/.env
**/.env.*
**/*.env

# IDE
.vscode
.idea
**/*.swp
**/*.swo

# Python — any depth
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/htmlcov
**/.coverage

# Node — any depth (frontend/node_modules must never enter the build context)
**/node_modules

# Data directories (mounted as volumes; root-level dir by design)
**/data/
**/*.db

# Documentation
**/*.md
LICENSE

# CI/CD
.github
.gitlab-ci.yml

# Docker
docker-compose*.yml
Dockerfile.*

# Secrets — any depth
**/*.pem
**/*.key
**/*.crt
**/credentials.json
